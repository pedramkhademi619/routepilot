[Unit]
Description=RoutePilot Traffic Policy Routing and Recovery Daemon
Documentation=https://github.com/routepilot/routepilot
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/routepilot-serviced
ExecStopPost=/usr/local/bin/routepilot-recover
Restart=on-failure
RestartSec=5s

# Minimal required capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true

# Security sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/routepilot /etc/routepilot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
